# Public site SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM_NAME=Rajput Events Website

# MongoDB
MONGO_URI=mongodb+srv://...
MONGO_DB_NAME=rajput-events-db
# Aliases also supported: MONGODB_URI, MONGODB_DB

# Single admin (no public registration)
ADMIN_EMAIL=admin@example.com
# Prefer bcrypt hash in production
ADMIN_PASSWORD_HASH=
# Dev-only plaintext fallback
ADMIN_PASSWORD=change-me

# Session / JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=8
JWT_EXPIRATION=8h

# Business defaults
BUSINESS_TIMEZONE=Asia/Karachi
BUSINESS_CURRENCY=PKR
